      <h1>Medikamenti</h1>
      <p class="page-subtitle">Pārvaldi savu mājdzīvnieku medikamentus un lietošanas kursus.</p>
    </div>

    <%= link_to "+ Pievienot medikamentu", new_medication_path, class: "primary-button" %>
  </div>

  <div class="content-card">
    <div class="section-header">
      <h2>Medikamentu saraksts</h2>
