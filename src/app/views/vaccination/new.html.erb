<div class="app-layout">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <span class="logo-icon">♡</span>
      <span>PetCare</span>
    </div>

    <nav class="sidebar-nav">
      <%= link_to root_path, class: "sidebar-link" do %>
        <span>⌂</span> Sākums
      <% end %>

      <%= link_to pets_path, class: "sidebar-link" do %>
        <span>♡</span> Mājdzīvnieki
      <% end %>

      <%= link_to vaccinations_path, class: "sidebar-link active" do %>
        <span>✚</span> Vakcinācijas
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>▣</span> Veterinārārsta apmeklējumi
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>♧</span> Medikamenti
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>⌁</span> Svara uzskaite
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>♧</span> Paziņojumi
      <% end %>
    </nav>

    <div class="sidebar-bottom">
      <%= link_to "#", class: "sidebar-link" do %>
        <span>⚙</span> Iestatījumi
      <% end %>

      <div class="sidebar-profile">
        <div class="profile-avatar">B</div>
        <div>
          <strong>Lietotājs</strong>
          <small>Mājdzīvnieka īpašnieks</small>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <%= link_to "← Atpakaļ uz vakcinācijām", vaccinations_path, class: "back-link" %>

    <header class="dashboard-header">
      <div>
        <p class="eyebrow">VESELĪBAS APRŪPE</p>
        <h1>Pievienot vakcināciju <span>♡</span></h1>
        <p class="header-description">
          Reģistrē jaunu mājdzīvnieka vakcināciju.
        </p>
      </div>
    </header>

    <div class="pet-form-container">
      <div class="form-card">
        <div class="form-card-heading">
          <div>
            <h2>Vakcinācijas informācija</h2>
            <p>Aizpildi informāciju par veikto vakcināciju.</p>
          </div>
          <span>✚</span>
        </div>

        <form>
          <div class="pet-form-grid">
            <div class="form-field">
              <label for="pet">Mājdzīvnieks *</label>
              <select id="pet" required>
                <option value="">Izvēlies mājdzīvnieku</option>
                <option value="1">Minka (kaķis)</option>
                <option value="2">Riko (suns)</option>
              </select>
            </div>

            <div class="form-field">
              <label for="vaccine">Vakcīna *</label>
              <select id="vaccine" required>
                <option value="">Izvēlies vakcīnu</option>
                <option value="Trakumsērgas vakcīna">Trakumsērgas vakcīna</option>
                <option value="Kombinētā vakcīna">Kombinētā vakcīna</option>
                <option value="Cita vakcīna">Cita vakcīna</option>
              </select>
            </div>

            <div class="form-field">
              <label for="vaccination_date">Vakcinācijas datums *</label>
              <input type="date" id="vaccination_date" required>
            </div>

            <div class="form-field">
              <label for="next_date">Nākamās vakcinācijas datums</label>
              <input type="date" id="next_date">
            </div>

            <div class="form-field full-width">
              <label for="notes">Piezīmes</label>
              <textarea id="notes" rows="4" placeholder="Papildu informācija par vakcināciju..."></textarea>
            </div>
          </div>

          <div class="form-actions">
            <%= link_to "Atcelt", vaccinations_path, class: "cancel-button" %>
            <button type="button" class="primary-button">
              Saglabāt vakcināciju
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>