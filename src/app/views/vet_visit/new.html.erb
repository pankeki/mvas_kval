<div class="app-layout">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <span class="logo-icon">♡</span>
      <span>PetCare</span>
    </div>

    <nav class="sidebar-nav">
      <%= link_to root_path, class: "sidebar-link" do %>
        <span>⌂</span> Sākums
      <% end %>

      <%= link_to pets_path, class: "sidebar-link" do %>
        <span>♡</span> Mājdzīvnieki
      <% end %>

      <%= link_to vaccinations_path, class: "sidebar-link" do %>
        <span>✚</span> Vakcinācijas
      <% end %>

      <%= link_to vet_visits_path, class: "sidebar-link active" do %>
        <span>▣</span> Veterinārārsta apmeklējumi
      <% end %>

      <%= link_to medications_path, class: "sidebar-link" do %>
        <span>♧</span> Medikamenti
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>⌁</span> Svara uzskaite
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>♧</span> Paziņojumi
      <% end %>
    </nav>

    <div class="sidebar-bottom">
      <%= link_to "#", class: "sidebar-link" do %>
        <span>⚙</span> Iestatījumi
      <% end %>

      <div class="sidebar-profile">
        <div class="profile-avatar">B</div>
        <div>
          <strong>Lietotājs</strong>
          <small>Mājdzīvnieka īpašnieks</small>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <%= link_to "← Atpakaļ uz apmeklējumiem", vet_visits_path, class: "back-link" %>

    <header class="dashboard-header">
      <div>
        <p class="eyebrow">VESELĪBAS APRŪPE</p>
        <h1>Pievienot apmeklējumu <span>♡</span></h1>
        <p class="header-description">
          Reģistrē jaunu mājdzīvnieka veterinārārsta apmeklējumu.
        </p>
      </div>
    </header>

    <div class="pet-form-container">
      <div class="form-card">
        <div class="form-card-heading">
          <div>
            <h2>Apmeklējuma informācija</h2>
            <p>Aizpildi informāciju par veterinārārsta apmeklējumu.</p>
          </div>
          <span>▣</span>
        </div>

        <form>
          <div class="pet-form-grid">
            <div class="form-field">
              <label for="pet">Mājdzīvnieks *</label>
              <select id="pet" required>
                <option value="">Izvēlies mājdzīvnieku</option>
                <option value="1">Minka (kaķis)</option>
                <option value="2">Riko (suns)</option>
              </select>
            </div>

            <div class="form-field">
              <label for="visit_date">Apmeklējuma datums *</label>
              <input type="date" id="visit_date" required>
            </div>

            <div class="form-field">
              <label for="veterinarian">Veterinārārsts *</label>
              <input type="text" id="veterinarian" placeholder="Vārds, uzvārds" required>
            </div>

            <div class="form-field">
              <label for="clinic">Veterinārā klīnika *</label>
              <input type="text" id="clinic" placeholder="Klīnikas nosaukums" required>
            </div>

            <div class="form-field full-width">
              <label for="diagnosis">Diagnoze</label>
              <textarea id="diagnosis" rows="3" placeholder="Norādi noteikto diagnozi..."></textarea>
            </div>

            <div class="form-field full-width">
              <label for="treatment">Ārstēšana</label>
              <textarea id="treatment" rows="3" placeholder="Norādi ieteikto vai veikto ārstēšanu..."></textarea>
            </div>

            <div class="form-field full-width">
              <label for="notes">Piezīmes</label>
              <textarea id="notes" rows="4" placeholder="Papildu informācija par apmeklējumu..."></textarea>
            </div>
          </div>

          <div class="form-actions">
            <%= link_to "Atcelt", vet_visits_path, class: "cancel-button" %>
            <button type="button" class="primary-button">
              Saglabāt apmeklējumu
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>