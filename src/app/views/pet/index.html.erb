<div class="app-layout">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <span class="logo-icon">♡</span>
      <span>PetCare</span>
    </div>

    <nav class="sidebar-nav">
      <%= link_to root_path, class: "sidebar-link" do %>
        <span>⌂</span> Sākums
      <% end %>

      <%= link_to pets_path, class: "sidebar-link active" do %>
        <span>♡</span> Mājdzīvnieki
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>✚</span> Vakcinācijas
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>▣</span> Veterinārārsta apmeklējumi
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>♧</span> Medikamenti
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>⌁</span> Svara uzskaite
      <% end %>

      <%= link_to "#", class: "sidebar-link" do %>
        <span>♧</span> Paziņojumi
      <% end %>
    </nav>

    <div class="sidebar-bottom">
      <%= link_to "#", class: "sidebar-link" do %>
        <span>⚙</span> Iestatījumi
      <% end %>
      <div class="sidebar-profile">
        <div class="profile-avatar">B</div>
        <div>
          <strong>Lietotājs</strong>
          <small>Mājdzīvnieka īpašnieks</small>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">MĀJDZĪVNIEKU PĀRVALDĪBA</p>
        <h1>Mani mājdzīvnieki <span>♡</span></h1>
        <p class="header-description">
          Šeit vari apskatīt un pārvaldīt savus mīluļus.
        </p>
      </div>

      <%= link_to "+ Pievienot mājdzīvnieku", new_pet_path, class: "primary-button" %>
    </header>

    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon pink">♡</div>
        <div>
          <p>Kopā mājdzīvnieki</p>
          <h2>2</h2>
          <small>Reģistrēti profili</small>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon green">♡</div>
        <div>
          <p>Kaķi</p>
          <h2>1</h2>
          <small>Reģistrēti kaķi</small>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon peach">♡</div>
        <div>
          <p>Suņi</p>
          <h2>1</h2>
          <small>Reģistrēti suņi</small>
        </div>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <h2>Visi mājdzīvnieki</h2>
          <p>Izvēlies mājdzīvnieku, lai apskatītu tā informāciju.</p>
        </div>
      </div>

      <%= link_to pet_path(1), class: "pet-card pet-list-card pet-card-link" do %>
        <div class="pet-avatar pet-cat">🐱</div>
        <div class="pet-info">
          <span class="pet-type">KAĶIS</span>
          <h3>Minka</h3>
          <p>3 gadi · Mātīte</p>
          <span class="pet-status">Vesels</span>
        </div>
      <% end %>

      <%= link_to pet_path(2), class: "pet-card pet-list-card pet-card-link" do %>
        <div class="pet-avatar pet-dog">🐶</div>
        <div class="pet-info">
          <span class="pet-type">SUNS</span>
          <h3>Riko</h3>
          <p>5 gadi · Tēviņš</p>
          <span class="pet-status">Vesels</span>
        </div>
      <% end %>
    </section>
  </main>
</div>